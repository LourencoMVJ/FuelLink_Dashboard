{
    "name": "fuellink/backend",
    "description": "Privileged PHP API backend for the Fuellink & Bankers Tankers Management Platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "private/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration"
    },
    "config": {
        "sort-packages": true
    }
}
